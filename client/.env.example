# The frontend calls the backend API at this base URL.
# Set it to the deployed backend origin (no trailing slash, no /api path):
#   VITE_API_URL=https://your-backend-domain.com
#
# When unset or empty, the frontend falls back to same-origin '/api' — the mode
# where the Express server also serves the built frontend from the same URL.
VITE_API_URL=
